# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# Virtual environments
.venv/
venv/
env/
ENV/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Tooling / editors
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Fetched evaluation assets. Downloaded by tools/fetch_data.py, verified by
# SHA-256, never committed and never packaged -- some are non-commercial or
# share-alike licensed and would contaminate the MIT wheel. See data/LICENSES.md
# (which IS tracked) for the ledger.
# Note: this must be `data/*`, not `data/`. Git will not re-include a file whose
# parent directory is itself excluded, so `data/` + `!data/LICENSES.md` silently
# ignores the ledger too.
data/*
!data/LICENSES.md

# Benchmarks & scratch output
benchmarks/results/
*.prof
scratch/

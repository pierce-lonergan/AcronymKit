# Normalise to LF in the repository and in every checkout.
#
# The bundled lexicons and n-gram models are compared byte-for-byte by
# tools/build_ngram_model.py --check and by the CI job that asserts the two
# copies of the interchange schema are identical. Platform-dependent line
# endings would make those checks fail on Windows runners only.
* text=auto eol=lf

# Explicitly textual, so no heuristic is involved.
*.py     text eol=lf diff=python
*.pyi    text eol=lf diff=python
*.txt    text eol=lf
*.json   text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
*.md     text eol=lf diff=markdown
*.yml    text eol=lf
*.yaml   text eol=lf
LICENSE  text eol=lf
MANIFEST.in text eol=lf
py.typed text eol=lf

# Binary — never touch.
*.gz     binary
*.zip    binary
*.whl    binary
*.png    binary
*.onnx   binary

# Keep generated resources out of diffs and language statistics; they are
# regenerated by tools/build_ngram_model.py, not hand-edited.
src/acronymkit/resources/ngram_*.json linguist-generated=true
src/acronymkit/resources/lexicon_*.txt linguist-generated=true

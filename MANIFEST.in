# Source distribution contents.
#
# setuptools' default sdist rules pick up `tests/test*.py` but NOT conftest.py,
# and skip top-level data directories entirely. Without this file the shipped
# sdist cannot run its own test suite (every test module imports from conftest)
# and omits the interchange schema, the resource tooling and the docs.

include LICENSE
include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include MANIFEST.in
include pyproject.toml
include .editorconfig

recursive-include src/acronymkit *.py py.typed
recursive-include src/acronymkit/resources *.json *.txt *.gz

recursive-include tests *.py
include tests/conftest.py

# The test suite's data, not just its code. `recursive-include tests *.py`
# shipped the assertions and left the fixtures behind, so the sdist's own suite
# died on a missing JSON file -- the third time this distribution has shipped a
# claim without the thing that backs it (the first was bench/results.json, the
# second data/LICENSES.md). `tests/test_packaging_manifest.py` now derives the
# rule from the tree instead of from memory: every non-Python file under
# tests/fixtures/ must match a line in this file, so the next fixture in a new
# format fails locally rather than in the release job.
recursive-include tests/fixtures *.json *.jsonl *.csv *.txt *.md

# `recursive-include tests *.py` already carries `tests/airgap_socket_guard.py`,
# the pytest plugin the `air-gap` CI job runs the suite under (verified against
# a built sdist, not assumed). That is deliberate rather than incidental: an
# enterprise that has to satisfy itself the library performs no network I/O
# should be able to re-run the proof on their own hardware, under their own
# kernel, from the artifact they were given -- shipping the assertion without
# the means to check it is exactly the pattern this project keeps refusing.
#   PYTHONPATH=tests python -m pytest -p airgap_socket_guard

# The runnable Java example. docs/JAVA_INTEROP.md links to it as the working
# demonstration of the supported interop route, and a reader holding an sdist
# rather than a checkout would otherwise follow that link to nothing. Small,
# and it is source rather than build output -- `target/` is gitignored.
recursive-include examples *.java *.xml *.json *.txt *.md

recursive-include schemas *.json
recursive-include tools *.py
recursive-include docs *.md

# The evidence for the numbers in the shipped docs. `docs/` and `src/` carry
# accuracy claims and `tools/check_claims.py` is the gate that backs every one
# of them, so an sdist that ships the assertions without `bench/results.json`
# and the allowlist ships a checker that cannot pass -- which is how it first
# broke. Anyone who downloads the sdist can now re-verify every published
# number offline. The rest of `bench/` stays out: the runners need fetched
# corpora and optional dependencies that an sdist has no business assuming.
include bench/results.json
include tools/claims_allowlist.txt
# And the fourth time the same way. `tools/check_claims.py` gained
# `bench/splits.toml` as a scan target, so the shipped checker started reading a
# file the sdist did not ship, reported `1 scan target(s) absent` and broke its
# own value-matched ratchet -- green in a checkout, red only in the extracted
# tree. The rule this file keeps learning is one rule: WHATEVER THE GATE READS,
# THE SDIST SHIPS. It is now derived rather than remembered --
# `tests/test_packaging_manifest.py` walks `check_claims.SCAN_GLOBS` and fails
# locally when a target is added here without a line, which is the check that
# would have caught this one and the three before it.
include bench/splits.toml
recursive-include .github/workflows *.yml

# The provenance and licence terms of every third-party data asset. SECURITY.md
# cites this file as the evidence behind "third-party data assets are pinned and
# checksummed", and README/conftest cite it for why only English ships a lexicon
# -- so leaving it out made those links unresolvable for anyone holding a
# distribution rather than a checkout, which is the audience the claim is aimed
# at. Only the ledger ships. The corpora it describes stay out: `data/` measures
# 34,482,534 B here, several of its assets are copyleft, and
# `tools/fetch_data.py` re-fetches every one of them against the SHA-256 digests
# recorded in the source.
include data/LICENSES.md

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
prune .github/ISSUE_TEMPLATE
prune benchmarks/results
